# Copy to .env for local dev. Never commit a populated .env (see repo-root .gitignore).

# --- Cross-package shared vars (docs/INTERFACE_CONTRACT.md §3) ---
OPA_URL=http://localhost:8181
ORACLE_URL=http://localhost:8080
RPC_URL=http://localhost:8545
CHAIN_ID=31337
DEPLOYMENTS_FILE=../deployments.local.json

# --- OPA ---
OPA_PACKAGE_PATH=/v1/data/integrity/bcc
OPA_TIMEOUT_SECONDS=3.0

# --- Commitment freshness ---
BCC_MAX_AGE_MS=60000

# --- Shadow (monitor-only) mode ---
# When true, the gate evaluates every commitment and records what enforcement
# WOULD have blocked (audit decision="shadow_deny") but never actually denies
# and never trips the circuit breaker. The zero-risk way to deploy in front of
# real agent traffic first, watch the would-be-block report, then flip to
# enforcement. Default true = observe. Set false only for explicit blocking.
# Registration status or a missing compliance pack must not block tools.
BCC_SHADOW_MODE=true
# Comma-separated exact intent types or runtime risk classes that deny when
# the secondary on-chain quarantine read cannot be verified.
BCC_QUARANTINE_FAIL_CLOSED_INTENTS=chain_write,destructive,credential,privileged,EMR_WRITE,DISPENSE_MEDICATION,BILLING_SUBMISSION,SECURE_EMR_WRITE,CLINICAL_DATA_ACCESS

# --- Circuit breaker ---
BCC_CB_VIOLATION_THRESHOLD=3
# 60s dev-tuned default (app/config.py's Settings.circuit_breaker_lockout_seconds has the
# full reasoning) -- this breaker is shared per agent DID across the Claude Code hook and
# the Hermes/agy runtime, so background policy noise from one can lock out an unrelated
# interactive session's tools too. Set this back to 900+ for any internet-facing deployment
# facing real adversarial traffic -- this default trades containment speed for local-dev
# ergonomics, deliberately, and that tradeoff is wrong outside dev.
BCC_CB_LOCKOUT_SECONDS=60

# --- On-chain BAA check ---
# Must be SmartBAAFactory specifically (implements isBAAActive); the
# per-pair SmartBAA escrow instances it creates do not implement it.
BAA_CONTRACT_NAME=SmartBAAFactory

# --- Merkle anchoring ---
STATE_ANCHOR_CONTRACT_NAME=StateAnchor
BCC_MERKLE_BATCH_SIZE=8
# Flush a non-empty partial batch after this many seconds so low-traffic
# commitments do not remain unanchored indefinitely.
BCC_MERKLE_ANCHOR_ENABLED=true
BCC_MERKLE_ANCHOR_INTERVAL_SECONDS=300
# Dev-only anvil default account #0 private key -- NEVER a real key.
ANCHOR_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Reputation sync / slashing (app/reputation.py, app/scoring_loop.py) ---
# Falls back to ANCHOR_SIGNER_PRIVATE_KEY when unset -- see app/reputation.py's
# module docstring for why that's correct on today's single-operator testnet.
# Set this explicitly once production key-separation happens.
REPUTATION_SIGNER_PRIVATE_KEY=
SCORE_SYNC_ENABLED=true
SCORE_SYNC_INTERVAL_SECONDS=300
DISPUTE_ENABLED=true
DISPUTE_MIN_EVENTS=5
DISPUTE_FLAGGED_RATIO_THRESHOLD=0.5
DISPUTE_LOOKBACK_BUCKET=1h
DISPUTE_STAKE_BPS=1000
DISPUTE_COOLDOWN_SECONDS=86400

# --- Durable audit-report spool (app/spool.py) ---
# Retries a failed oracle POST (report_decision/report_anchor_events) from a local
# SQLite file instead of silently dropping it. See app/spool.py's module docstring.
BCC_SPOOL_ENABLED=true
BCC_SPOOL_DB_PATH=
SPOOL_RETRY_INTERVAL_SECONDS=30
SPOOL_MAX_BACKOFF_SECONDS=900

# --- Signed policy pack (app/pack_policy.py; docs/runbooks/bcc-policy-pack.md) ---
# Everything below is optional and OFF by default: with BCC_POLICY_PACK_DIR unset, policies/bcc.rego
# decides exactly as before.
#
# Setting BCC_POLICY_PACK_DIR turns on DUAL-RUN: the signed pack is evaluated beside bcc.rego on every
# request, disagreements are logged ("POLICY DIVERGENCE") and counted on /health, and bcc.rego still
# decides. Then BCC_POLICY_ENGINE=pack makes the pack decide (fail closed; the service refuses to start
# if the pack does not verify). Setting it back to `rego` is the rollback.
BCC_POLICY_ENGINE=rego
# A signed copy of packs/bcc (must contain pack.sig.json).
BCC_POLICY_PACK_DIR=
# Comma-separated multibase Ed25519 public keys allowed to have signed the pack. REQUIRED with a pack.
BCC_TRUSTED_PACK_SIGNERS=
# Optional but recommended: pin the exact pack hash (sha256:...) the operator approved.
BCC_POLICY_PACK_HASH=
# A DEDICATED OPA for the pack. REQUIRED with a pack; there is deliberately no fallback to OPA_URL
# (two gates' packs share a policy id, so sharing one OPA would have each overwrite the other's pack).
BCC_PACK_OPA_URL=
# {"agents": [...]}: extra agents allowed to commit clinical intents, re-read when the file changes.
# An invalid or missing file authorizes NO extra agents (fail closed). Required for the pack to know
# about agents bcc.rego gets from its OPA data document / PUT /v1/admin/clinical-allowlist.
BCC_CLINICAL_ALLOWLIST_FILE=

# --- Signed decision receipts (B2 stage 3). OFF unless BCC_RECEIPT_DIR is set. ---
# One signed, hash-chained, checkpointed receipt per decision made AFTER the commitment's signature verifies.
# STRICT by default: in enforce mode an allow whose receipt cannot be written is denied (BCC_RECEIPT_UNAVAILABLE).
# Both key files must be mode 0600. Signing key: Ed25519 PEM. HMAC key: >= 32 raw bytes
# (`head -c 32 /dev/urandom > hmac.key`), held by the organization; the gate id and actions appear only as HMACs.
BCC_RECEIPT_DIR=
BCC_RECEIPT_KEY_FILE=
BCC_RECEIPT_HMAC_KEY_FILE=
BCC_GATE_ID=bcc-middleware
BCC_RECEIPT_CHECKPOINT_EVERY=1000
# An epoch is closed (final checkpoint) and a new one opened at whichever bound is hit first. 0 disables a bound.
BCC_RECEIPT_EPOCH_MAX_RECEIPTS=50000
BCC_RECEIPT_EPOCH_MAX_AGE_SECONDS=86400
# Let an allow through when its receipt cannot be written (availability over a complete record).
BCC_LENIENT_RECEIPTS=false
