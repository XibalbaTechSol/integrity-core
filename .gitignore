# --- secrets & local env ---
.env
.env.local
.env.*.local
*.pem
*.key
deployments.local.json
!.env.example
# Real, public AWS Nitro root CA cert (not a secret) — attestation.py pins its SHA-256
# fingerprint and needs the file present to verify real Nitro attestation documents.
!integrity-sdk/integrity_sdk/security/trust_roots/aws_nitro_root_g1.pem
# Same cert, vendored into the oracle so its Docker build context (./integrity-oracle) doesn't
# need a ../../integrity-sdk include_str! path — attestation.rs's build fails without it (the
# blanket *.pem rule above was silently excluding this one too, breaking CI on a fresh checkout).
!integrity-oracle/backend/trust_roots/aws_nitro_root_g1.pem

# --- node / dashboard ---
node_modules/
dist/
build/
coverage/
.vite/

# --- python ---
__pycache__/
*.pyc
.venv/
venv/
.venv*/
*venv*/
.pytest_cache/
*.egg-info/

# --- rust ---
target/
Cargo.lock.bak

# --- foundry ---
contracts/out/
contracts/cache/
contracts/broadcast/**/run-*.json

# --- noir ---
**/target/
Prover.toml
Verifier.toml

# --- misc ---
.DS_Store
*.log
.idea/
.vscode/
# Personal/machine-local Claude Code settings (absolute paths, per-machine permission
# grants) — not meant to be shared, same convention as .env.local.
.claude/settings.local.json
.anvil-state.json

# Local test-run record consumed by the Trust Vault post-commit hook. Describes a run on THIS
# machine against THIS tree, not a property of the repository — committing it would let one
# developer's run vouch for everyone's commits.
.integrity-test-status
