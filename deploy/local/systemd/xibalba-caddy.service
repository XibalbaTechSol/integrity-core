[Unit]
Description=Xibalba local TLS front door (Cortex :9443, Shield :9444)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/caddy run --config /home/xibalba/Projects/integrity-core/deploy/local/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
