# CORE -> Shield policy publisher. Copy to /etc/xibalba-integrity/policy-publisher.env
CORE_ORACLE_URL=http://127.0.0.1:8080
SHIELD_URL=http://127.0.0.1:8765
SHIELD_TENANT_ID=
SHIELD_ADMIN_TOKEN=
SHIELD_POLICY_VERSION=
SHIELD_POLICY_JSON={"rules":[]}
CORE_POLICY_PUSH_INTERVAL_SECONDS=60
CORE_POLICY_PUSH_MAX_ATTEMPTS=8
CORE_POLICY_PUSH_STATE=/var/lib/xibalba-integrity/policy-publisher.sqlite3
# Configure the issuer verification key on Shield separately:
# XIBALBA_ORACLE_POLICY_PUBLIC_KEY=file:/etc/xibalba-integrity/oracle-policy-issuer.pub
