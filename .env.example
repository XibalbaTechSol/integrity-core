# ============================================================
# Integrity Protocol — root .env (gitignored)
# Copy this to .env and fill in the values for your target network.
#
# docker-compose reads this file automatically. The oracle-backend
# service passes RPC_URL, CHAIN_ID, and DEPLOYMENTS_FILE through
# to the Rust oracle — change these three to switch networks.
# ============================================================

# ── Target network ───────────────────────────────────────────
# Local anvil (default — used by `make chain` and all unit tests):
#   RPC_URL=http://localhost:8545
#   CHAIN_ID=31337
#   DEPLOYMENTS_FILE=../deployments.local.json
#
# Base Sepolia (live stack):
#   RPC_URL=https://sepolia.base.org          # free public endpoint, rate-limited
#   RPC_URL=https://base-sepolia.g.alchemy.com/v2/<YOUR_KEY>   # Alchemy (recommended)
#   CHAIN_ID=84532
#   DEPLOYMENTS_FILE=../deployments.baseSepolia.json

RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
DEPLOYMENTS_FILE=../deployments.baseSepolia.json

# ── Signing keys (dev/testnet only — never commit real values) ─
# Required by the demo scenario engine (integrity-mvp/demo/) and
# the CLI for on-chain registration. Not needed to run the oracle
# in read-only mode.
FUNDER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
ORACLE_SIGNER_PRIVATE_KEY=
GOVERNANCE_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=
INTEGRITY_WALLET_PASSWORD=

# ── Base Sepolia RPC (also used by foundry scripts) ───────────
# Same value as RPC_URL above — foundry.toml references this name
# directly in its [rpc_endpoints] table.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── KYC provider trust roots (oracle-backend) ──────────────────
# Comma-separated `provider=hex-ed25519-public-key` pairs. Each key is an
# independently operated (commercial or self-hosted open-source) KYC verifier's
# receipt-signing key — the oracle never sees raw PII, only a signed, nonce-bound
# receipt asserting document/biometric/sanctions checks passed. Empty disables
# KYC receipt acceptance entirely (the endpoint 400s for any provider id).
# See integrity-oracle/backend/src/kyc.rs and docs/INTERFACE_CONTRACT.md §6.3a.
KYC_PROVIDER_KEYS=

# ── Dev-only verification tier override (oracle-backend) ───────
# An explicit, loud escape hatch for local development, where climbing to Tier 3
# legitimately cannot be done (KYC needs a real provider account; TEE needs real
# enclave hardware). Requires BOTH vars — neither alone does anything. Applied at
# READ time only, never persisted, and every response carrying an overridden tier
# reports `tier_source: "dev_override"` so it can never be mistaken for a real
# proof. MUST NOT be set in production. See integrity-oracle/backend/src/
# verification.rs's "Development tier override" module docs.
INTEGRITY_ALLOW_DEV_TIER_OVERRIDE=0
# did=tier pairs, comma separated, e.g.: did:integrity:aaa=3,did:integrity:bbb=2
INTEGRITY_DEV_TIER_OVERRIDES=
